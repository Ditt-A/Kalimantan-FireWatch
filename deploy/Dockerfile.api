FROM python:3.14-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 postgresql-client && rm -rf /var/lib/apt/lists/*
COPY requirements-production.txt .
RUN pip install --no-cache-dir -r requirements-production.txt
COPY api api
COPY src src
COPY scripts scripts
COPY deploy/weather_locations.json deploy/weather_locations.json
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
