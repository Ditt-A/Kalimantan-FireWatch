# Leave unset to use the same-origin Next.js proxy below. This is the default
# needed for a public tunnel, because visitors must never call their own
# localhost:8000. Set only when serving the API at a deliberate public gateway.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.org/api/v1

# Optional self-hosted raster OSM tile endpoint. Leave unset for an intentionally
# plain operational map background during local development.
# NEXT_PUBLIC_OSM_TILE_URL=http://localhost:8080/tile/{z}/{x}/{y}.png
